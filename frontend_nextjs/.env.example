# Frontend (Next.js SPA) environment variables
#
# The UI calls the backend REST API directly from the browser.
# Configure the backend base URL via NEXT_PUBLIC_API_BASE.

# Backend API base URL used by the browser.
#
# Cloud preview (this workspace):
#   https://vscode-internal-11829-beta.beta01.cloud.kavia.ai:3001
#
# Local dev:
#   http://localhost:3001
#
# NOTE: The code also has a hardcoded cloud-preview fallback when this env var
# is undefined, but keeping it here makes configuration explicit.
NEXT_PUBLIC_API_BASE=https://vscode-internal-11829-beta.beta01.cloud.kavia.ai:3001
